# Python
__pycache__/
*.py[cod]
*.so
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.pyright/
.ruff_cache/
.hypothesis/
.tox/
.nox/

# Virtual environments
venv/
.venv/
.venv.*/
.venv-*/
env/

# Environment variables
.env
.env.*
!.env.example
!**/.env.example

# Secrets and private credentials
*.pem
*.key
*.p12
*.pfx
credentials*.json
service-account*.json

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Data (never commit large data)
data/
/data_find/
*.db
*.sqlite
*.sqlite3

# Logs
logs/
*.log
.codex-log/

# Test coverage
htmlcov/
.coverage
.coverage.*
coverage.xml
coverage/

# Docker
docker-compose.override.yml

# Node (frontend)
node_modules/
.pnpm-store/
.vite/
.next/
out/
.nuxt/

# Build artifacts
dist/
build/

# AI logs — keep only the tracked directory marker; hooks manage log content
.ai-log/*
!.ai-log/.gitkeep

# Evaluation caches are reproducible and may contain sensitive model I/O.
# Keep manifests, qrels, reviewed JSON artifacts and results/report.md tracked.
/evaluation/**/.cache/
/eval/**/.cache/

# Local slide-generation prompts
*/slides_generation_prompt.txt
*/slides_generation_prompt.md

# Supabase local temp files (keep config.toml, migrations/, seed.sql tracked)
supabase/.branches/
supabase/.temp/

# Worktrees (skill using-git-worktrees)
.worktrees/

# Project agent instructions/config are intentional source files.
# Keep AGENTS.md, .agents/ and the tracked .codex/.cursor hooks in Git.
# Subagent-driven-development scratch workspace (ledgers, briefs, reports)
.superpowers/
