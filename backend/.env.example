# Backend (never commit real secrets)
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Local Supabase (`npx supabase start` → use values from `npx supabase status`)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
# Production: set APP_ENV=production AND a unique JWT secret (startup fails on the default).

# Optional LLM (legacy /chat)
OPENAI_API_KEY=
MODEL_NAME=gpt-4o-mini

# Qwen Cloud (OpenAI-compatible DashScope). Set QWEN_API_KEY in this file.
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=
LLM_MODEL=qwen3.7-flash
EMBEDDING_MODEL=qwen3.7-text-embedding

# Per-agent model overrides (optional)
# Format: MODEL_<AGENT_NAME_UPPER>=<model_name>
# Available agents: routing, recommend, matching, evaluation, ingest, skill_gap
# Example: MODEL_EVALUATION=qwen-turbo
# MODEL_ROUTING=qwen3.7-flash
# MODEL_RECOMMEND=qwen3.7-flash
# MODEL_MATCHING=qwen3.7-flash
# MODEL_EVALUATION=qwen3.7-flash
# MODEL_INGEST=qwen3.7-flash
