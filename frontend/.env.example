# Copy this file to `new_frontend/.env`.
# Vite exposes vars prefixed with VITE_ or NEXT_PUBLIC_.

# Local Supabase (`npx supabase start` → paste anon key from `npx supabase status`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# FastAPI backend
VITE_API_BASE_URL=http://localhost:8000
