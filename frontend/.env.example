# Frontend environment variables (Vite).
# Copy this file to `frontend/.env` and fill in the values.
# Vite exposes vars prefixed with VITE_ or NEXT_PUBLIC_ (see vite.config.ts).

# Supabase project URL and anon/publishable key (required).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Base URL of the FastAPI backend (used for health checks; optional for UI).
VITE_API_BASE_URL=http://localhost:8000
